# HeatGuard Environment Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True

# Database Configuration
# For SQLite (Development):
DATABASE_URL=sqlite:///instance/heatguard.db

# For PostgreSQL (Production - uncomment and configure):
# DATABASE_URL=postgresql://user:password@localhost:5432/heatguard

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-12345

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Machine Learning Model Path
MODEL_PATH=../models/random_forest.pkl

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Alert Thresholds
TEMP_CRITICAL_THRESHOLD=38.5
TEMP_WARNING_THRESHOLD=37.5
HR_CRITICAL_THRESHOLD=120
HR_WARNING_THRESHOLD=100

# System Configuration
LOG_LEVEL=INFO
MAX_LOGIN_ATTEMPTS=5
